# Absolute production URL used for canonical and social-preview metadata.
NEXT_PUBLIC_SITE_URL=https://zhyronne.workwithoddly.com

# Contact form delivery through the Google Apps Script in scripts/contact-form.gs.
CONTACT_SCRIPT_URL=https://script.google.com/macros/s/your_deployment_id/exec
CONTACT_SCRIPT_SECRET=same_value_as_the_script_CONTACT_SECRET_property

# Server-side portfolio chatbot configuration.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Screen Room (/movies). TMDB supplies the catalog (server-side); accepts a v3 API key or a v4 read-access token.
TMDB_API_KEY=your_tmdb_api_key

