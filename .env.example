# Absolute production URL used for canonical and social-preview metadata.
NEXT_PUBLIC_SITE_URL=https://zhyronne-batican.vercel.app

# Contact form delivery through Resend.
RESEND_API_KEY=re_your_api_key
CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>
CONTACT_TO_EMAIL=zhyronnebatican@gmail.com

# Server-side portfolio chatbot configuration.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Screen Room (/movies). TMDB supplies the catalog (server-side); accepts a v3 API key or a v4 read-access token.
TMDB_API_KEY=your_tmdb_api_key

