// Cloudflare Workers config for the OpenNext build (`npm run deploy`).
// Secrets (GEMINI_API_KEY, CONTACT_SCRIPT_URL, CONTACT_SCRIPT_SECRET) are set in the dashboard or
// with `npx wrangler secret put <NAME>`, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Served only at https://zhyronne.workwithoddly.com; the workers.dev and preview URLs are off.
  "name": "portfolio",
  "routes": [{ "pattern": "zhyronne.workwithoddly.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Pages are prerendered into the static assets (see open-next.config.ts), so there is
  // no KV cache, revalidation queue or image-resizing binding.
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  },
  // Run in Singapore: visitors routed through Hong Kong otherwise hit Gemini's
  // "User location is not supported", and Singapore stays close to the Philippines.
  "placement": { "mode": "targeted", "region": "gcp:asia-southeast1" },
  "observability": { "enabled": true }
}
