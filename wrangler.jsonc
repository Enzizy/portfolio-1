// Cloudflare Workers config for the OpenNext build (`npm run deploy`).
// Secrets (GEMINI_API_KEY, TMDB_API_KEY, RESEND_API_KEY) are set in the dashboard or
// with `npx wrangler secret put <NAME>`, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Served at https://zhyronne.workwithoddly.com. The old workers.dev address stays on and
  // redirects there (see next.config.ts).
  "name": "portfolio",
  "routes": [{ "pattern": "zhyronne.workwithoddly.com", "custom_domain": true }],
  // Wrangler turns workers.dev off once routes exist; keep it so old links can redirect.
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // ISR revalidation (GitHub stats, TMDB data) calls back into this same worker.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "portfolio" }],
  // Cached pages and fetches (KV namespace "portfolio-cache").
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "7a4406a08d6d4a1182bc9a968ccc1225" }],
  // next/image resizing.
  "images": { "binding": "IMAGES" },
  "vars": {
    "CONTACT_TO_EMAIL": "zhyronnebatican@gmail.com",
    "GEMINI_MODEL": "gemini-3.1-flash-lite"
  },
  "observability": { "enabled": true }
}
